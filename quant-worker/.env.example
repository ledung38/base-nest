# NestJS Backend API (nguồn warm-up nến chốt 1000 bar)
FINTRADE_API_URL=http://localhost:8000

# Apache Kafka (tiêu thụ nến chốt từ topic market.candles)
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_CANDLES=market.candles
KAFKA_GROUP_ID=fintrade-quant-worker

# RabbitMQ (đẩy tín hiệu 1 / -1 vào queue trading.signals)
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_SIGNAL_QUEUE=trading.signals
RABBITMQ_SIGNAL_DLX=signals.dlx
RABBITMQ_SIGNAL_DLQ=trading.signals.dlq

# Danh sách cặp coin & khung thời gian theo dõi
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
INTERVALS=1m,5m,15m,1h,1d
WARMUP_BARS=1000

# Tham số chiến lược Alpha Confluence
ALPHA_RSI_PERIOD=14
