## DEFAULT
NODE_ENV=development
PORT=8000
TIME_ZONE=Asia/Ho_Chi_Minh
API_KEY=your-secret-api-key

## DATABASE (PostgreSQL)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=fintrade_db

## REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_USER_AUTH=86400

## RABBITMQ (Transaction Plane)
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

## APACHE KAFKA (Market Data Streaming Plane)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=fintrade-engine
KAFKA_GROUP_ID=fintrade-group

## CENTRIFUGO (Realtime WebSocket Gateway)
CENTRIFUGO_API_URL=http://localhost:8001/api
CENTRIFUGO_API_KEY=fintrade-centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=fintrade-centrifugo-hmac-secret-key
CENTRIFUGO_ADMIN_PASSWORD=Admin@123
CENTRIFUGO_ADMIN_SECRET=fintrade-centrifugo-admin-secret
CENTRIFUGO_PORT=8001

## BINANCE MARKET STREAM
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_SYMBOLS=btcusdt,ethusdt,solusdt

## JWT
JWT_EXPIRE_IN=604800
JWT_SECRET=fintrade-super-jwt-secret-key-development

## AWS S3 (Optional for uploads)
AWS_REGION=us-east-1
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
AWS_S3_BUCKET_NAME=my-bucket

## CRON JOBS
CRON_CLEAN_STORAGE_EXPRESSION=0 03 * * *
CRON_BACKUP_DATABASE_EXPRESSION=0 03 * * *
CLEAN_STORAGE_THRESHOLD_SECOND=3600
