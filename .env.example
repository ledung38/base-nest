## DEFAULT
NODE_ENV=development
PORT=8000
TIME_ZONE=Asia/Ho_Chi_Minh
API_KEY=your-secret-api-key

## DATABASE
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=base_db

## REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL_USER_AUTH=86400

## JWT
JWT_EXPIRE_IN=604800
JWT_SECRET=your-jwt-secret-key

## AWS S3
AWS_REGION=us-east-1
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
AWS_S3_BUCKET_NAME=my-bucket

## CRON JOBS
CRON_CLEAN_STORAGE_EXPRESSION=0 03 * * *
CRON_BACKUP_DATABASE_EXPRESSION=0 03 * * *
CLEAN_STORAGE_THRESHOLD_SECOND=3600
